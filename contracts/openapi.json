{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "IoT Smart Irrigation — dispositivo HTTP",
    "version": "1.0.0",
    "description": "Contrato executável do piloto HTTP v1. API humana do portal é documentada em docs/CONTRATO_API.md, fora deste OpenAPI. Limites do ESP32 serão avaliados antes do firmware."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Laboratório local; produção exige TLS"
    }
  ],
  "tags": [
    {
      "name": "Dispositivo",
      "description": "Token por GUID, separado de contas humanas"
    }
  ],
  "paths": {
    "/iot/v1/telemetry": {
      "post": {
        "operationId": "Receber_telemetria",
        "summary": "Receber telemetria",
        "description": "accepted confirma persistência local, não entrega externa. Repetição exige mesmo ID e conteúdo.",
        "tags": [
          "Dispositivo"
        ],
        "security": [
          {
            "DeviceBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta após processamento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelemetryAck"
                }
              }
            }
          },
          "400": {
            "description": "Contrato, referência, revisão ou transição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido, revogado ou dispositivo arquivado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Rota inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Corpo acima de 128 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "POST exige application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Falha interna; aceitação não confirmada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Telemetry"
              }
            }
          }
        }
      }
    },
    "/iot/v1/configuration": {
      "get": {
        "operationId": "Consultar_configuracao_desejada",
        "summary": "Consultar configuração desejada",
        "description": "Aplicar somente após validar hash e limites locais; confirmar revisão/hash em ACK.",
        "tags": [
          "Dispositivo"
        ],
        "security": [
          {
            "DeviceBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta após processamento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigurationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Contrato, referência, revisão ou transição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido, revogado ou dispositivo arquivado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Rota inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Corpo acima de 128 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "POST exige application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Falha interna; aceitação não confirmada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/iot/v1/configuration/ack": {
      "post": {
        "operationId": "Confirmar_configuracao",
        "summary": "Confirmar configuração",
        "description": "Aplicação exige idle=true e hash correspondente. Revisão nunca regride.",
        "tags": [
          "Dispositivo"
        ],
        "security": [
          {
            "DeviceBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta após processamento",
